{% extends 'threeColumns.html.twig' %}
{% import 'macros.html.twig' as formRender %}

{% block content %}
    {% set translationPrefix, groupsController = 'projectdetails.pages.groups.', 'Projectdetails--groups' %}
    {% set examinedPrefix, hasTextInput = translationPrefix~'examined.', textInput is not same as [] %}
    <div {{ stimulus_controller(groupsController,{
            'examined': examined,
            'hasTextInput': hasTextInput,
            'criteriaHint': criteriaHint,
            'includeStart': includeStart,
            'firstInclude': firstInclude,
            'firstIncludeSentence': (content.includeText.vars.value ?? '')|trim|split("\n")[0]
    }) }}>
        <div id="examinedPeopleDiv">
            {{ formRender.addHeading(examinedPrefix~'title',{'headingHint': [[examinedPrefix~'headingHint',routeIDsParam]]}) }}
            {# age #}
            {% set unlimited = content.unlimited %}
            <div {{ stimulus_action(groupsController,'setExamined','change') }}>
                <div class="MetaData-Widget grid gap-2 mt-2" style="grid-template-columns: minmax(min-content,max-content) min-content auto">
                    {% for age in ['minAge', 'maxAge'] %}
                        {% set widget = content[age] %}
                        <div class="flex justify-content-end" id="{{ age }}" style="grid-column: 1">
                            {{ form_label(widget) }}:
                        </div>
                        <div style="width: 4rem">
                            {{ form_widget(widget,addTargetArray(groupsController,widget.vars.name)) }}
                        </div>
                    {% endfor %}
                    {{ formRender.addCheckbox(unlimited, {'target': [groupsController,unlimited.vars.name]}) }}
                </div>
            <div class="mt-4 mb-4">{{ formRender.addHint(translationPrefix~'wardsHint',{'target': [groupsController,'wardsHint']}) }}</div>
            {# examined people #}
            {% set isTextInputVoluntary, voluntaryHintParams = textInputVoluntary is not same as '', removeHint|merge({'target': [groupsController,'voluntaryHint']}) %}
            {% set targets, styleHeight = {}, addStyle(textHeight,true) %}
            {% for type, target in {'healthy': 'healthy', 'wards': 'wards', 'physical': 'physical', 'examinedConsent': 'examinedConsent'}|merge(isTextInputVoluntary ? dependentTypes : {}) %}
                {% set targets = targets|merge({(type): [groupsController,target]}) %}
            {% endfor %}
            <div class="MetaData-Widget mt-2" id="examinedPeople">
                {{ formRender.addMultilevelCheckboxGroup(content,'groups.examined',examinedAll,examinedOther,examinedIcons,[],false,targets) }}
            </div>
        </div>
            {% if hasTextInput %}
                {% for type, hint in textInput %}
                    {{ formRender.addHint(hint,removeHint|merge({'target': [groupsController,type]})) }}
                {% endfor %}
            {% endif %}
            {% if isTextInputVoluntary %}
                {{ formRender.addHint(textInputVoluntary,voluntaryHintParams) }}
            {% endif %}
            {# disease #}
            <div class="mt-8" id="disease" style="{{ boolToDisplay(content.physical.vars.checked) }}" {{ stimulus_target(groupsController,'disease') }}>
                {{ formRender.renderButtons(content.disease,{'hint': [translationPrefix~'disease.']}) }}
            </div>
            {# people description #}
            <div {{ stimulus_target(groupsController,'examinedDescription') }}>
                {{ formRender.addTextfield(content.peopleDescription,styleHeight|merge(fontNormal)|merge({'hint': examinedPrefix~'description'})) }}
            </div>
        </div>
        {# criteria #}
        {% if content.include is defined %} {# either both include and exclude or neither exist #}
            {% set addresseeParam, tempPrefix, classes, criteriaTransfer = {'addressee': addresseeType, 'information': information}, translationPrefix~'criteria.', 'MetaData-Label mt-4', [information in ['pre',''] ? transferInfo : [''],''] %}
            <div class="mt-8" id="criteria" {{ stimulus_action(groupsController,'setCriteria','input') }}>
                <div>{{ formRender.addHeading(tempPrefix~'title') }}
                    <span class="MetaData-Label hint italic" {{ stimulus_target(groupsController,'criteriaHint') }}>{{ 'multiple.wording'|trans(addresseeParam|merge({'isBold': 'true'}))|raw }}</span>
                </div> {# heading hint italic to be different from the start of the following sentence #}
                {% for type in ['include','exclude'] %}
                    {% set textField, prefix, isInclude = content[type~'Text'], tempPrefix~type~'.', type is same as 'include' %}
                    <div class="{{ classes }}" id="{{ type~'Start' }}" style="margin-bottom: -1rem" {% if isInclude %} {{ stimulus_target(groupsController,'includeStart') }} {% endif %}>{{ (prefix~'start')|trans(addresseeParam) }}</div>
                    <div {% if isInclude %} {{ stimulus_action(groupsController,'checkFirstInclusion','keydown',{'furtherAllowed': ['Enter']}) }} {% endif %}>{{ formRender.addTextfield(textField,addStyle('white-space: pre; overflow-wrap: normal; '~textHeight,true)|merge({'transfer': criteriaTransfer, 'hint': prefix~'hint', 'textHintParams': {'type': type}})|merge(isInclude ? {'contTarget': [groupsController,type]} : {})) }}</div>
                    <div class="MetaData-Widget pt-0">
                        {{ formRender.addCheckbox(content[type]) }}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        {# sample size #}
            {% if content.total is defined %}
            {% set tempPrefix = translationPrefix~'sampleSize.' %}
            {% set totalPrefix = tempPrefix~'total.' %}
            <div class="mt-8" id="total">
                {{ formRender.addHeading(tempPrefix~'title') }}
                <div class="MetaData-Label">{{ (totalPrefix~'title')|trans }}</div>
                {{ formRender.addHint(totalPrefix~'textHint') }}
                <div class="MetaData-Widget" style="width: 8rem">{{ form_widget(content.total) }}</div>
                {{ formRender.addTextfield(content.furtherParticulars) }}
                <div class="MetaData-Widget mt-8" style="margin-bottom: -1.25rem" id="sampleSizePlan">{{ (tempPrefix~'plan.title')|trans }}</div> {# id is same as text field id #}
                {{ formRender.addTextfield(content.sampleSizePlan, styleHeight) }}
            </div>
        {% endif %}
        {# recruitment #}
        {% set recruitmentPrefix, notAnySelected = translationPrefix~'recruitment.', not getAnySelected(content,recruitmentTypes)[1] %}
        {% set recruitmentFurtherPrefix, recruitmentFurther = recruitmentPrefix~'recruitmentFurther.', content.recruitmentFurther ?? '' %}
        {% set hints, hasFurther = [(recruitmentFurtherPrefix~'missing')|trans,'multiple.optional'|trans~' '~((recruitmentFurtherPrefix~'description')|trans)], recruitmentFurther is not same as '' %}
        <div class="mt-8" id="recruitment" {% if hasFurther %} {{ stimulus_action('base','setCheckboxTextfield','change',{'checkboxes': [recruitmentTypes,'recruitmentFurtherDiv',hints]}) }} {% endif %}>
            {{ formRender.addHeading(recruitmentPrefix~'title') }}
            <div class="MetaData-Widget">{{ formRender.addMultiLevelCheckboxGroup(content,'groups.recruitment',recruitmentTypesAll,recruitmentTypesOther,recruitmentIcons,[],false) }}</div>
        </div>
        {% if hasFurther %}
            {{ formRender.addTextfield(recruitmentFurther,
                {'hint': hints[notAnySelected ? 0 : 1],
                 'contTarget': [groupsController,'recruitmentDescription']}|
                merge(notAnySelected ? {'target': recruitmentFurther.vars.name} : {})) }}
        {% endif %}
        {{ formRender.addSubmitButtons() }}
    </div> {# entire form including stimulus controller #}
{% endblock %}

{% block preview %}
    {{ formRender.addPreview([studyID,groupID,measureID]) }}
{% endblock %}
