{% extends 'threeColumns.html.twig' %}
{% import 'macros.html.twig' as formRender %}

{% block content %}
    {% set translationPrefix, burdensRisksController, everydayDiv = 'projectdetails.pages.burdensRisks.','Projectdetails--burdensRisks', 'burdensEverydayDiv' %}
    {% set parameter, everyday, burdensWoNo, risksWoNo = routeIDsParam|merge({'isDebriefing': isDebriefing}), content.burdensEveryday, burdensRisksTypes['burdens']|slice(1), burdensRisksTypes['risks']|slice(1) %}
    {% set informing, isTransfer, isTextInput = content.informing, transferInfo is not same as [], textInputCon is not same as '' %}
    {% set informingValue, transferArrayValue, textInputVisible, textHintParams = informing.vars.value, isTransfer ? [transferInfo,addresseeType] : [], isTextInput and (not (getAnySelected(content,burdensWoNo)[1] and everyday.vars.value is same as '0' or getAnySelected(content,risksWoNo)[1])), {'burdens': burdensWoNo, 'risks': risksWoNo} %}
    <div {{ stimulus_controller(burdensRisksController,{
            'informing': informingValue,
            'informingHints': informingHints
    }) }}>
        {# burdens and risks #}
        {% for type in ['burdens','risks','burdensRisksContributors','burdensRisksUninvolved'] %}
            {% set isBurdens, isRisks, typePrefix, checkboxes, compensationDiv = type is same as 'burdens', type is same as 'risks', translationPrefix~type~'.', burdensRisksTypes[type], type~'CompensationDiv' %}
            {% set checkboxesWoNo, description, noKey = checkboxes|slice(1), type~'Description', 'no'~(type[:1]|upper~type[1:]) %}
            {% set selections = getAnySelected(content,checkboxes,noKey) %}
            {% set anySelected = selections[1] %}
            {% set visibility = boolToDisplay(anySelected) %}
            <div {% if not isBurdens %} class="mt-8" {% endif %} id="{{ type }}">
                {{ formRender.addHeading(typePrefix~'title',{'headingHint': [[typePrefix~'hints.headingHint']]}) }}
                <div class="MetaData-Widget" {{ stimulus_action('base','setMultiCheckbox','change',{'single': noKey, 'multiCheck': checkboxesWoNo})|stimulus_action('base','setVisibility','change',{'multi':
                    [[checkboxesWoNo,[description~'Div']|
                                      merge(isBurdens ? [everydayDiv] : (isRisks ? ['risksOccurrence'] : [compensationDiv]))]]|
                    merge(isRisks ? [[['risksIncidental','risksSuspicion'],'finding']] : [])})|
                    stimulus_action(burdensRisksController,'setTextInputHint','change',textHintParams)}}>
                    {{ _self.addMultilevelCheckboxGroup(content,burdensRisksTypesAll[type],burdensRisksOther[type],burdensRisksIcons[type],parameter,false,selections[0] ? checkboxesWoNo : (anySelected ? [noKey] : []),[],transferArrayValue) }}
                </div>
            </div>
            {{ formRender.addTextfield(content[description],fontNormal|merge({'visibility': anySelected})) }}
            {% if isBurdens %}
                {# burdens everyday #}
                <div class="mt-8" id="{{ everydayDiv }}" style="{{ visibility }}">
                    {{ formRender.renderButtons(everyday, {
                        'stim': [burdensRisksController,'setTextInputHint',textHintParams],
                        'contTarget': ['burdensEveryday0',burdensRisksController,'burdensEverydayYes']}) }}
                </div>
            {% endif %}
            {% if type in ['burdens','risks'] and isTextInput %}
                <div class="mt-8">{{ formRender.addHint(textInputCon,{
                        'visible': textInputVisible,
                        'remove': true,
                        'target': [burdensRisksController,'textInput']
                    }) }}
                </div>
            {% endif %}
            {% if isRisks %}
                {# finding #}
                {% set tempPrefix = translationPrefix~'finding.'%}
                {% set addresseeStringParam = {'addressee': addresseeString} %}
                <div class="mt-8" id="finding" style="{{ boolToDisplay(content.risksIncidental.vars.checked or content.risksSuspicion.vars.checked) }}">
                    {{ formRender.addHeading(tempPrefix~'title') }}
                    {{ formRender.addTextfield(content.description) }}
                    {# informing #}
                    {% set tempPrefix = tempPrefix~'informing.' %}
                    {{ formRender.renderButtons(informing,
                        {'hint': [tempPrefix,addresseeStringParam],
                         'labelParams': addresseeStringParam,
                         'stim': [burdensRisksController,'setInformingValue'],
                         'addDiv': ['informing','margin-bottom: 1rem']}) }}
                    {% if information is same as 'pre' %}
                        <div class="mt-4">
                            {{ formRender.addHint(tempPrefix~'hint',{
                                'visible': informingValue is same as 'always',
                                'target': [burdensRisksController,'findingHint']}) }}
                        </div>
                    {% endif %}
                    {% for type in informingTemplates %}
                        {% set id = type~'Template' %}
                        {% set div, text = id~'Div', id~'Text' %}
                        <div id="{{ div }}" {{ stimulus_target(burdensRisksController,div) }}>
                            <div id="{{ text }}" {{ stimulus_target(burdensRisksController,text) }}>
                                <div class="template mb-1">{{ (tempPrefix~'templates.'~type)|trans|raw }}</div>
                            </div>
                        </div>
                    {% endfor %}
                    <div class="MetaData-Label mt-4" id="informingDescriptionDiv" {{ stimulus_target(burdensRisksController,'informingHint') }}></div> {# text is set in controller #}
                    <div class="grid MetaData-Widget" style="grid-template-columns: auto {% if isTransfer %} min-content {% endif %} min-content" {{ stimulus_target(burdensRisksController,'descriptionDiv') }}>
                        {{ form_widget(content.informingDescription,{'attr': addClass('pe-0', false, resizeHeight~'width: -webkit-fill-available')|merge(addTarget(burdensRisksController,'informingDescription'))}) }}
                        {% if isTransfer %}
                            <div class="pe-2" {{ stimulus_target(burdensRisksController,'informingPDF') }}>{{ formRender.addPDFhint(transferInfo,addresseeType) }}</div>
                        {% endif %}
                        <div class="MetaData-Widget" {{ stimulus_action(burdensRisksController,'setInforming','change')|stimulus_target(burdensRisksController,'informingTemplateDiv') }}>{{ formRender.addCheckbox(content.informingTemplate,addStyle('white-space: nowrap')|merge({'target': [burdensRisksController,'informingTemplate']})) }}</div>
                    </div>
                </div>
                {# risks occurrence #}
                {% set tempPrefix, isAnyRisk, checkboxes = translationPrefix~'risksOccurrence.', getAnySelected(content,burdensRisksTypes['risks'],'noRisks')[1], burdensRisksTypes['risksOccurrence'] %}
                {% set checkboxesWoNo, selections = checkboxes|slice(1), getAnySelected(content,checkboxes,'noRisksOccurrence') %}
                <div class="mt-8" id="risksOccurrence" style="{{ boolToDisplay(isAnyRisk) }}">
                    {{ formRender.addHeading(tempPrefix~'title',{'headingHint': [[tempPrefix~'hints.headingHint']]}) }}
                    <div class="MetaData-Widget" {{ stimulus_action('base','setMultiCheckbox','change',{'single': 'noRisksOccurrence', 'multiCheck': checkboxesWoNo})|stimulus_action('base','setVisibility','change',{'multi': [['noRisksOccurrence','risksNoMeasure'],['trigger','risksTrigger'],[checkboxesWoNo,'risksAfter']]}) }}>
                        {{ _self.addMultilevelCheckboxGroup(content,burdensRisksTypesAll['risksOccurrence'],burdensRisksOther['risksOccurrence'],burdensRisksIcons['risksOccurrence'],parameter,true,selections[0] ? checkboxesWoNo : (selections[1] ? ['noRisksOccurrence'] : []),['contactInfo','contactOther','burdensome','triggerOther'],transferArrayValue) }}
                    </div>
                    {# explanation why no measures are taken #}
                    <div class="mt-4" id="risksNoMeasure" style="{{ boolToDisplay(content.noRisksOccurrence.vars.checked) }}">
                        {{ formRender.addHeading(translationPrefix~'risksNoMeasure.title') }}
                        <div class="MetaData-Widget" {{ stimulus_action('base','setVisibility','change',{'multi': [['risksNoMeasureOther','risksNoMeasureDescriptionDiv']]}) }}>{{ formRender.addCheckboxGroup(content,risksNoMeasureTypes) }}</div>
                        {{ formRender.addTextfield(content.risksNoMeasureDescription,fontNormal|merge({'visibility': content.risksNoMeasureOther.vars.checked})) }}
                    </div>
                    {# trigger #}
                    {% set triggerOther, triggerIcons, isTransfer, tempPrefix = burdensRisksOther['risksTrigger'], burdensRisksIcons['risksTrigger'], transferArrayValue is not same as [], translationPrefix~'risksTrigger.' %}
                    <div class="mt-8" id="risksTrigger" style="{{ boolToDisplay(isAnyRisk and content.trigger.vars.checked) }}">
                        {{ formRender.addHeading(tempPrefix~'title') }}
                        <div class="MetaData-Widget">
                            {% for trigger in burdensRisksTypes['risksTrigger'] %}
                                {% set widget, templateDiv, otherText = content[trigger], trigger~'Template', trigger~'Text' %}
                                {% set visibility, isOther, isNotTriggerOther = boolToDisplay(widget.vars.checked,1), trigger in triggerOther, trigger is not same as 'triggerOther' %}
                                <div class="grid topMarginButtons" {{ stimulus_action('base','setVisibility','change',{'multi': [[trigger, (isOther ? [otherText] : [])|merge(isNotTriggerOther ? [templateDiv] : [])]], 'isGrid': true}) }}>
                                    {{ formRender.addCheckbox(widget,(trigger in triggerIcons ? {'checkIcon': [(translationPrefix~'icons.'~trigger)|trans(parameter)]} : {})) }}
                                    {% if isNotTriggerOther %}
                                        <div class="mt-2 mb-2 template" id="{{ templateDiv }}" style="{{ visibility }}">
                                            {{ (tempPrefix~'templates.'~trigger)|trans }}
                                        </div>
                                    {% endif %}
                                    {% if isOther %}
                                        {% set other, isTransfer = content[otherText], transferArrayValue is not same as [] %}
                                        <div class="MetaData-Widget mb-1 grid" id="{{ other.vars.name }}" style="{{ visibility }}; {% if isTransfer %} grid-template-columns: auto min-content; {% endif %}">
                                            {{ form_widget(other) }}
                                            {% if isTransfer %}
                                                {{ formRender.addPDFhint(transferArrayValue[0],transferArrayValue[1]) }}
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    {# risks after #}
                    {{ formRender.renderButtons(content.risksAfter,{'addDiv': ['risksAfter',boolToDisplay(selections[1])]}) }}
                </div>
            {% elseif type in ['burdensRisksContributors','burdensRisksUninvolved'] %}
                <div class="mt-8" id="{{ compensationDiv }}" style="{{ visibility }}">
                    {% set compensation, compensationPrefix = content[type~'Compensation'], translationPrefix~'compensation.textHints.' %}
                    {% set value = compensation.vars.value %}
                    {% set noSelection, yesTrans, noTrans = value is same as '', (compensationPrefix~'yes')|trans({'type': type}), (compensationPrefix~'no')|trans %}
                    {{ formRender.renderButtons(compensation,{
                        'text': [content[type~'CompensationDescription'],fontNormal|merge({'hint': noSelection ? 'multiple.choiceTextHint' : (value is same as '0' ? yesTrans : noTrans), 'attributes': textMinHeightLong|merge({'disabled': noSelection})})],
                        'stim': ['base','setWidgetByValue',{'widgetValue': ['',type~'CompensationDescription',{'0': yesTrans, '1': noTrans}]}]}) }}
                </div>
            {% endif %}
        {% endfor %}
        {# feedback #}
        {% if content.feedback is defined %}
            {% set feedback = content.feedback %}
            {{ formRender.renderButtons(feedback,{'text': [content.feedbackDescription,fontNormal|merge({'visibility': feedback.vars.value is same as '0'})], 'hint': [translationPrefix~'feedback.'], 'stimVisible': {'values': [['0','feedbackDescriptionDiv']]}, 'addDiv': ['feedback']}) }}
        {% endif %}
        {{ formRender.addSubmitButtons() }}
    </div> {# entire form #}
{% endblock %}

{% macro addMultilevelCheckboxGroup(content, names, otherTypes, iconTypes, parameter, isBold, disable = [], otherPDF = [], transfer = []) %}
    {# Creates a group of checkboxes that may have several subcategories. Input arguments:
        content:    form element with the checkboxes
        names:      array of names of checkboxes. Each element may be a key-value pair
        otherTypes: array with IDs of elements for which a text field is added
        iconTypes:  array with IDs of elements or names of subcategories for which an icon is added
        parameter:  parameter for the translations
        isBold:     if true, then the subheading will be displayed in bold, otherwise underlined. Only the first level of subheadings may be bold
        disable:    IDs of elements which get disabled
        otherPDF:   arry with IDs of elements for which a pdf symbol is added next to the text field
        transfer:   array for the pdf-icon call. 0: transfer elements, 1: addressee
    #}
    {% set translationPrefix = 'projectdetails.pages.burdensRisks.' %}
    {% set iconPrefix = translationPrefix~'icons.' %}
    {% for key, value in names %}
        {% if value is iterable %} {# subheading #}
            <div class="topMarginButtons ms-1">
                <div class="{{ isBold ? 'font-bold' : 'text-decoration-underline' }}">{{ (translationPrefix~'typesMain.'~key)|trans }}{% if key in iconTypes %}{{ formRender.addIcon((iconPrefix~key)|trans(parameter)) }}{% endif %}</div>
                <div class="ms-3">
                    {{ _self.addMultilevelCheckboxGroup(content,value,otherTypes,iconTypes,parameter,false,disable,otherPDF,transfer) }}
                </div>
            </div>
        {% else %} {# selectable option #}
            {% set widget, isOther = content[value], value in otherTypes %}
            <div class="grid topMarginButtons" {% if isOther %} {{ stimulus_action('base','setVisibility','change',{'multi': [[value, [value~'Text']]], 'isGrid': true}) }} {% endif %}>
                {{ formRender.addCheckbox(widget,
                    (value in iconTypes ? {'checkIcon': [(iconPrefix~value)|trans(parameter)]} : {})|
                    merge(value in disable ? {'disable': true} : {})) }}
                {% if isOther %}
                    {% set other, isTransfer = content[value~'Text'], value in otherPDF and transfer is not same as [] %}
                    <div class="MetaData-Widget mb-1 grid" id="{{ other.vars.name }}" style="{{ boolToDisplay(widget.vars.checked,1) }}; {% if isTransfer %} grid-template-columns: auto min-content; {% endif %}">
                        {{ form_widget(other) }}
                        {% if isTransfer %}
                            {{ formRender.addPDFhint(transfer[0],transfer[1]) }}
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block preview %}
    {{ formRender.addPreview([studyID,groupID,measureID]) }}
{% endblock %}
