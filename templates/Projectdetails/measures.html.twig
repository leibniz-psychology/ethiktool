{% extends 'threeColumns.html.twig' %}
{% import 'macros.html.twig' as formRender %}

{% block content %}
    {% set translationPrefix, measuresController, location = 'projectdetails.pages.measures.', 'Projectdetails--measures', content.location ?? '' %}
    {% set measuresInterventionsPrefix, interventionsTypes, locationPrefix, locationValue = translationPrefix~'measuresInterventions.', measuresInterventionsTypes['interventions'], translationPrefix~'location.', location.vars.value ?? '' %}
    {% set measuresHintPrefix, hintsPrefix, isInformation = measuresInterventionsPrefix~'measures.textHints.', measuresInterventionsPrefix~'hints.', information in ['pre','post',''] %}
    {% set measuresSentence, anyIntervention, multipleParam, transferParam = (measuresHintPrefix~'description')|trans, getAnySelected(content,interventionsTypes,'noIntervention'), {'multiple': boolToString(multipleStudyGroupMeasure)}, {'transfer': [transferInfo,addresseeType]} %}
    <div {{ stimulus_controller(measuresController,{
            'measuresTypes': measuresInterventionsTypes['measures'],
            'measuresBodyTypes': measuresBodyTypes,
            'measuresDescription': [(measuresHintPrefix~'noSelection')|trans,measuresSentence,measuresSentence~(measuresHintPrefix~'interventionsQuestionnaire')|trans],
            'interventionsTypes': interventionsTypes|slice(1),
            'location': locationValue,
            'locationInput': textInputs|slice(1)
    }) }}>
        {# procedure #}
        {% if content.procedure is defined %}
            <div id="procedure">
                {{ formRender.addCountableTextfield(content.procedure,maxCharsProcedure,{'hint': [[(translationPrefix~'procedure.'~headingHint)|trans(multipleParam)~(isInformation ? ' '~('multiple.wording')|trans({'addressee': addresseeString, 'isBold': 'true'}))]]}|merge(isInformation ? {'transfer': [isInformation ? transferInfo : [''],'']} : {})) }}
            </div>
        {% endif %}
        {# measures and interventions #}
        {% for type in ['measures','interventions'] %}
            {% set typePrefix, isInterventions, description, params, pdf = measuresInterventionsPrefix~type~'.', type is same as 'interventions', type~'Description', {'type': type}, content[type~'PDF'] ?? '' %}
            <div class="mt-8" id="{{ type }}">
                {{ formRender.addHeading(measuresInterventionsPrefix~'title',{'params': params, 'headingHint': [[typePrefix~'headingHint',routeIDsParam]]}) }}
                <div class="MetaData-Widget" {{ stimulus_action(measuresController,'setMeasuresInterventions','change',params) }}>
                    {{ _self.addMeasuresInterventions(content,measuresInterventionsTypesAll[type],measuresInterventionsOther[type],measuresInterventionsIcons[type],documentationTypes,measuresController,isInterventions and anyIntervention[0], isInterventions and anyIntervention[1]) }}
                </div>
                {{ formRender.addHint(hintsPrefix~'selection',{'target': [measuresController,type~'BurdensRisks'], 'params': params|merge(routeIDsParam)}) }}
            </div>
            {% if content[description] is defined %}
                <div {{ stimulus_target(measuresController,description~'Div') }}>
                    {{ formRender.addTextfield(content[description], fontNormal|merge(addStyle('',true))|merge(
                        {'hint': typePrefix~'textHints.description'}|
                        merge(not isInterventions ? {'contTarget': [measuresController,description]} : {}))) }}
                </div>  {# hint text may be set in controller, but must not be empty here #}
            {% endif %}
            {% if pdf is not same as '' %}
                <div {% if isInterventions %} {{ stimulus_target(measuresController,'interventionsPDF') }} {% endif %}>
                    <div class="mt-4">
                        {{ formRender.addHint(hintsPrefix~'pdf',{'params': params}) }}
                    </div>
                    <div class="MetaData-Widget">
                        {{ formRender.addCheckbox(content[type~'PDF'], {'labelParams': {'type': type}}) }}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        {# other sources #}
        {% set otherSources, tempPrefix, otherSourcesDiv = content.otherSources, translationPrefix~'otherSources.', 'otherSourcesDiv' %}
        <div class="mt-8" id="otherSources">
            {{ formRender.renderButtons(otherSources,{'hint': [tempPrefix], 'stimVisible': {'values': [['0',otherSourcesDiv]]}}) }}
            <div id="{{ otherSourcesDiv }}" style="{{ boolToDisplay(otherSources.vars.value is same as '0') }}">
                {{ formRender.addTextfield(content.otherSourcesDescription,fontNormal|
                    merge({'attributes': textMinHeightLong, 'hint': [translationPrefix~'otherSources']})|
                    merge(isInformation and reviewProcess not in ['fullBegun','fullRequested'] ? transferParam : {})) }}
                {{ formRender.addHint(tempPrefix~'hint',{'params': routeIDsParam}) }}
                <div class="mt-4">
                    {{ formRender.addHint(tempPrefix~'pdf.hint') }}
                    <div class="MetaData-Widget">
                        {{ formRender.addCheckbox(content.otherSourcesPDF) }}
                    </div>
                </div>
            </div>
        </div>
        {# loan #}
        {% if content.loan is defined %}
            {% set loan, receipt, apparatusHint = content.loan, content.receipt, textInputs['apparatus'] %}
            {% set receiptVars = receipt.vars %}
            {% set receiptValue, loanReceiptDiv, loanTemplate = receiptVars.value, 'receiptDiv', 'loanTemplate' %}
            <div class="mt-8" id="loan" {{ stimulus_action(measuresController,'setInputHints','change') }}>
                {{ formRender.renderButtons(loan,{'stimVisible': {'values': [['0',loanReceiptDiv]]}, 'contTarget': ['loan0',measuresController,'loanYes']}) }}
                <div class="mt-4" id="{{ loanReceiptDiv }}" style="{{ boolToDisplay(loan.vars.value is same as '0') }}">
                    <div class="MetaData-Label">{{ form_label(receipt,null,labelDummy) }}</div>
                    {{ formRender.renderButtons(receipt,noHeading|merge({'text': [content.receiptText,{'transfer': [['consent'],addresseeType], 'visibility': receiptValue is same as 'text'}], 'stimVisible': {'values': [['template',loanTemplate],['text',receiptVars.name~'TextDiv']]}})) }}
                    <div class="template" id="{{ loanTemplate }}" style="{{ boolToDisplay(receiptValue is same as 'template') }}">{{ (translationPrefix~'loan.template')|trans }}</div>
                </div>
                {% if apparatusHint is not same as '' %}
                    {{ formRender.addHint(apparatusHint,{'target': [measuresController,'loanInputHint'], 'remove': true}) }} {# hint text is set in controller, but must not be empty here #}
                {% endif %}
            </div>
        {% endif %}
        {# location #}
        {% if location is not same as '' %}
            {% set isLocation, bothHint, noLocation, locationHint = locationValue is not same as '', textInputs['both'], 'multiple.choiceTextHint'|trans, (locationPrefix~'textHint')|trans %}
            <div class="mt-8" id="location">
                {{ formRender.addHeading(locationPrefix~'title') }}
                <div class="MetaData-Label">{{ (locationPrefix~'start')|trans({'information': information}) }}{{ formRender.addPDFhint(transferInfo,addresseeType) }}</div>
                {{ formRender.renderButtons(location,noHeading|merge({
                    'text': [content.locationDescription,{'attributes': {'disabled': not isLocation}, 'contTarget': [measuresController,'locationDescription'], 'hint': isLocation ? locationHint : noLocation, 'markInput': true}],
                    'stim': [measuresController,'setLocation',{'hints': [noLocation, locationHint]}],
                    'icons': {'locationother': locationPrefix~'otherHint'},
                    'labelParams': committeeParams|merge({'routeIDs': '{&quot;studyID&quot;:&quot;'~studyID~'&quot;,&quot;groupID&quot;:&quot;'~groupID~'&quot;}'})})) }}
                <div class="MetaData-Label mb-4" style="{{ boolToDisplay(locationValue is same as 'online') }}" {{ stimulus_target(measuresController,'locationEnd') }}>{{ (locationPrefix~'end')|trans }}</div>
                {% if bothHint is not same as '' %}
                    {{ formRender.addHint(bothHint,{'target': [measuresController,'locationInputHint'], 'remove': true}) }} {# hint text is set in controller, but must not be empty here. If 'both' is emtpy, then 'insuranceWay' will also be empty, but not vice versa #}
                {% endif %}
                {% if textInputOnline is not same as '' %} {# the previous hint and this one can not be shown at the same time #}
                    {{ formRender.addHint(textInputOnline,{'target': [measuresController,'onlineHint'], 'remove': true}) }}
                {% endif %}
            </div>
        {% endif %}
        {# presence #}
        {% if content.presence is defined %}
            {% set presence = content.presence %}
            {{ formRender.renderButtons(presence,{
                'hint': [translationPrefix~'presence.'],
                'stimVisible': {'values': [['partly','presenceDescriptionDiv']]},
                'text': [content.presenceDescription,fontNormal|merge({'visibility': presence.vars.value is same as 'partly'})],
                'addDiv': ['presence']}) }}
        {% endif %}
        {# duration #}
        {% set durationPrefix, hasInput = translationPrefix~'duration.', textInputCompensation is not same as '' %}
        <div class="mt-8" id="duration" {{ stimulus_action(measuresController,'setDuration','change') }}>
            {{ formRender.addHeading(durationPrefix~'title',{'params': multipleParam}) }}
            {% for duration in ['measureTime','breaks'] %}
                {% set isBreaks = duration is same as 'breaks' %}
                <span {% if isBreaks %} {{ stimulus_target(measuresController,'duration') }} {% endif %}>
                    {% set tempPrefix = durationPrefix~duration~'.' %}
                    <u class="MetaData-Label mb-2 {% if loop.index is same as 2 %} mt-3 {% endif %}">{{ (tempPrefix~'title')|trans }}</u>
                    {% for curDur in (not isBreaks ? measureTimeTypes : ['breaksMinutes']) %}
                        {% set widget = content[curDur] %}
                        <div class="minAutoGrid mb-2" {% if curDur is not same as 'measureTimeDays' %} {{ stimulus_target(measuresController,'duration') }} {% endif %}>
                            <div class="MetaData-Label" style="width: 7rem">{{ (tempPrefix~curDur)|trans }}</div>
                            <div style="max-width: 4rem">{{ form_widget(widget,addTargetArray(measuresController,widget.vars.name)) }}</div>
                        </div>
                    {% endfor %}
                    {{ formRender.addHint(tempPrefix~'hint',{'target': [measuresController,'duration']}) }}
                </span>
            {% endfor %}
            {{ formRender.addTextfield(content.measureTimeDaysText,fontNormal|merge(transferParam)) }}
            {% if hasInput %}
                {{ formRender.addHint(textInputCompensation,{'target': [measuresController,'compensationHint'], 'remove': true}) }}
            {% endif %}
        </div>
        {{ formRender.addSubmitButtons() }}
    </div> {# entire form including stimulus controller #}
{% endblock %}

{% macro addMeasuresInterventions(content, measuresInterventions, otherTypes, iconTypes, documentationTypes, stimCont, noInterventionSelected, isAnyIntervention) %}
    {# Adds the measures and interventions widgets. Inputs arguments:
        content:                form elements
        measuresInterventions:  array with (sub-)options
        otherTypes:             array with IDs of elements for which a text field is added
        iconTypes:              array with IDs of elements for which an icon is added
        documentationTypes:     array with IDs of elements for which a question about documentation is added
        stimCont:               stimulus controller
        noInterventionSelected: true if intervention widgets are created and 'no intervention' is selected
        isAnyIntervention:      true if intervention widgets are created and any intervention except 'no intervention' is selected
    #}
    {% set translationPrefix = 'projectdetails.pages.measures.measuresInterventions.' %}
    {% set measuresPrefix = translationPrefix~'measures.' %}
    {% set documentationPrefix = measuresPrefix~'documentation.' %}
    {% for key, value in measuresInterventions %}
        {% if value is iterable %} {# sub-heading #}
            {% set isMeasuresBody = key is same as 'measuresBody' %}
            <div class="topMarginButtons ms-1">
                <div class="text-decoration-underline">{{ (translationPrefix~'typesMain.'~key)|trans }}</div>
                <div class="ms-3" {% if isMeasuresBody %} {{ stimulus_action('base','setVisibility','change',{'multi': [[value,'gene']], 'setOr': true}) }} {% endif %}>
                    {{ _self.addMeasuresInterventions(content,value,otherTypes,iconTypes,documentationTypes,stimCont,noInterventionSelected,isAnyIntervention) }}
                {# gene #}
                {% if isMeasuresBody %}
                    <div class="MetaData-Widget my-4" id="{{ 'gene' }}" style="{{ boolToDisplay(getAnySelected(content,value)[1]) }}">
                        <div>{{ (measuresPrefix~'gene')|trans }}</div>
                        {{ formRender.renderButtons(content.gene,noHeading) }}
                    </div>
                {% endif %}
                </div>
            </div>
        {% else %} {# selectable option #}
            {% set widget, isOther, isNoIntervention = content[value], value in otherTypes, value is same as 'noIntervention' %}
            {% set isCheckedStyle, isMeasuresQuestionnaire, surveyDiv = boolToDisplay(widget.vars.checked,1), value is same as 'measuresQuestionnaire', 'measuresSruveyDiv' %}
            <div class="grid topMarginButtons" {% if isOther %} {{ stimulus_action('base','setVisibility','change',{'multi': [[value, [value~'Text']|merge(isMeasuresQuestionnaire ? [surveyDiv] : [])]], 'isGrid': true}) }} {% endif %}>
                {{ formRender.addCheckbox(widget,
                    (value in iconTypes ? {'checkIcon': [(translationPrefix~'icons.'~value)|trans]} : {})|
                    merge({'disable': isNoIntervention and isAnyIntervention or not isNoIntervention and noInterventionSelected})|
                    merge(value in ['noIntervention','measuresInterview','measuresInterviewGroups','measuresQuestionnaire','interventionsQuestionnaire','invasiveExtract'] ? {'target': [stimCont,value in ['measuresQuestionnaire','measuresInterview','measuresInterviewGroups'] ? 'measuresQuestionnaire' : value]} : {})) }}
                {% if isOther %}
                    {% set other = content[value~'Text'] %}
                    <div class="MetaData-Widget mb-1 grid" id="{{ other.vars.name }}" style="{{ isCheckedStyle }}">
                        {{ form_widget(other) }}
                        {# documentation #}
                        {% if value in documentationTypes|keys %}
                            <div class="my-4" id="{{ value~'Div' }}">
                                <div class="mb-2">{{ (documentationPrefix~'title')|trans }}{{ formRender.addIcon((documentationPrefix~'hint')|trans) }}</div>
                                {{ formRender.addCheckboxGroup(content,documentationTypes[value],{'other': [value~'documentationOther']}) }}
                            </div>
                        {% endif %}
                        {# survey conduct and screening #}
                        {% if isMeasuresQuestionnaire %}
                            {% set surveyPrefix, screeningPrefix = measuresPrefix~'surveyConduct.', measuresPrefix~'screening.' %}
                            {% set tempPrefix = surveyPrefix~'icons.' %}
                            <div class="my-4" id="{{ surveyDiv }}" style="{{ isCheckedStyle }}">
                                <div class="mb-4" id="surveyConduct">
                                    <div>{{ (surveyPrefix~'title')|trans }}</div>
                                    {{ formRender.renderButtons(content.surveyConduct,noHeading|merge({'icons': {'surveyConductwritten': tempPrefix~'written', 'surveyConductoral': tempPrefix~'oral'}})) }}
                                </div>
                                <div id="screening">
                                    <div>{{ (screeningPrefix~'title')|trans }}{{ formRender.addIcon((screeningPrefix~'hint')|trans) }}</div>
                                    {{ formRender.renderButtons(content.screening,noHeading) }}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block preview %}
    {{ formRender.addPreview([studyID,groupID,measureID]) }}
{% endblock %}
