{% extends 'threeColumns.html.twig' %}
{% import 'macros.html.twig' as formRender %}

{% block content %}
    {% set appType, extended, committeeType, appProcess = content.appType, content.appTypeExtended, committeeParams['committeeType'], content.applicationProcess %}
    {% set style, projectLength, translationPrefix, coreDataController = 'max-width: 60rem', {'maxLength': 200}, 'coreData.', 'AppData--coreData' %}
    {% set isEUB, appTypePrefix, conflictPrefix, conflictHint = committeeType is same as 'EUB', translationPrefix~'appType.', translationPrefix~'conflict.', 'conflictHintDiv' %}
    {% set conflictYesDescription, projectTitle, extendedPrefix = (conflictPrefix~'yes')|trans, content.projectTitle, translationPrefix~'appTypeExtended.' %}
    <div {{ stimulus_controller(coreDataController, {
            'appType': appType.vars.value,
            'extended': extended.vars.value,
            'applicationProcess': appProcess.vars.value,
            'reviewProcess': reviewProcess,
            'reviewProcessLoad': reviewProcessLoad,
            'requestedConfirmHint': requestedConfirmArray,
            'positions': positions,
            'noChoice': 'multiple.choiceTextHint'|trans,
            'conflictHint': [conflictYesDescription,(conflictPrefix~'no')|trans],
            'conflictHintName': conflictHint}) }}>
        {# project title #}
        <div id="projectTitle">
            {{ form_label(projectTitle,null,addLabelAttributes(addClass('MetaData-Title'))) }}
            <div class="MetaData-Widget">{{ form_widget(projectTitle,{'attr': projectLength|merge(textInput)}) }}</div>
        </div>
        {# project title for participation documents #}
        {% set projectTitlePart, description, tempPrefix = content.projectTitleParticipation, content.projectTitleParticipationDescription, translationPrefix~'projectTitleParticipation.' %}
        <div class="mt-8" id="projectTitleParticipation" {{ stimulus_target(coreDataController,'projectTitleParticipation') }}>
            {{ formRender.renderButtons(projectTitlePart,{
                'hint': [tempPrefix],
                'icons': {'projectTitleParticipationnotApplicable': tempPrefix~'hint'},
                'text': [description,{'attributes': projectLength, 'visibility': projectTitlePart.vars.value is same as 'different', 'transfer': [transferInfo,'participants']}],
                'stimVisible': {'values': [['different', description.vars.name~'Div']]}}) }}
        </div>
        {# application type #}
        {% set tempPrefix = extendedPrefix~'hints.' %}
        <div class="mt-8" id="appType" {{ stimulus_action(coreDataController,'setApplicationType') }}>
            {{ formRender.renderButtons(appType,{'hint': [appTypePrefix,committeeParams], 'stim': [coreDataController,'setAppType']}) }}
            <div class="mt-4" {{ stimulus_target(coreDataController,'exDiv') }}>
                <div class="MetaData-Label" id="extendedDiv">{{ (extendedPrefix~'title')|trans }}</div>
                {{ formRender.renderButtons(extended,noHeading|merge({'stim': [coreDataController,'setExtended'], 'icons': {'appTypeExtendedextendedSame': tempPrefix~'extendedSame', 'appTypeExtendedextendedDifferent': tempPrefix~'extendedDifferent'}})) }}
            </div>
            <div  id="exReDiv" {{ stimulus_target(coreDataController,'exReDiv')}}>
                {% if isEUB %}
                    <div class="MetaData-Label font-bold mt-4" {{ stimulus_target(coreDataController,'hintTemplate') }}>{{ (appTypePrefix~'hintTemplate')|trans }}</div>
                {% endif %}
                <div class="MetaData-Label {% if isEUB %} mt-4 {% endif %}">{{ (appTypePrefix~'reference')|trans }}</div>
                <div class="MetaData-Widget" style="width: 20rem" >{{ form_widget(content.description,textInputAttr) }}</div>
                {{ formRender.addHint( appTypePrefix~'hint') }}
            </div>
        </div>
        {# application process #}
        <div class="mt-8" id="applicationProcess" {{ stimulus_action(coreDataController,'setReviewProcessWidgets','change') }}>
            {{ formRender.renderButtons(appProcess,{'hint': [translationPrefix~'applicationProcess.'], 'contTarget': ['applicationProcessfull',coreDataController,'applicationFull']}) }}
            {% if content.shortDocs is defined %}
                <div class="mt-4" id="shortDocs" {{ stimulus_target(coreDataController,'shortDocs') }}>
                    <div class="MetaData-Label">{{ (translationPrefix~'shortDocs.title')|trans(committeeParams) }}</div>
                    {{ formRender.renderButtons(content.shortDocs,noHeading|merge({'contTarget': ['shortDocsyes',coreDataController,'shortDocsYes']})) }}
                </div>
            {% endif %}
        </div>
        {# project start #}
        {% set projectStart, tempPrefix, fundingKeys = content.projectStart, translationPrefix~'project.', funding|keys %}
        {% set startPrefix, begun = tempPrefix~'start.', content.projectStartBegun ?? '' %}
        {% set hintsPrefix, labelParams = startPrefix~'hints.', {'labelParams': committeeParams} %}
        <div class="mt-8" id="projectDates">
            {{ formRender.addHeading(tempPrefix~'title',{'headingHint': [[hintsPrefix~'headingHint']]}) }}
            {{ form_label(projectStart,(startPrefix~'title')|trans({'committeeType': committeeType})~':',addLabelAttributes(addClass('MetaData-Label'))) }}
            <div class="MetaData-Widget fitWidth" style="height: min-content" {{ stimulus_action(coreDataController,'setProjectStart','change') }}>
                {{ form_widget(projectStart,{'attr': addTarget(coreDataController,'projectStart')}) }}
            </div>
            {# project start next #}
            <div class="MetaData-Widget" {{ stimulus_action(coreDataController,'setProjectStart','change') }}>
                {{ formRender.addCheckbox(content.projectStartNext, {'target': [coreDataController,'projectStartNext']}) }}
            </div>
            {% if content.projectStartBegun is defined %}
                {# research project has already started #}
                <div class="MetaData-Widget" {{ stimulus_action(coreDataController,'setProjectStart','change') }}>
                    {{ formRender.addCheckbox(begun,labelParams|merge({'target': [coreDataController,'projectStartBegun']})) }}
                    <div {{ stimulus_target(coreDataController,'projectStartBegunDiv') }}>
                        {{ formRender.addHint(hintsPrefix~'begun',{'params': committeeParams}) }}
                        {% if content.projectStartBegunConfirm is defined %}
                            {{ formRender.addCheckbox(content.projectStartBegunConfirm,labelParams|merge({'target': [coreDataController,'projectStartBegunConfirm'], 'style': 'margin-top: 1rem'})) }}
                        {% endif %}
                        <div {{ stimulus_target(coreDataController,'projectStartBegunText') }}>
                            {{ formRender.addTextfield(content.projectStartBegunText,fontNormal) }}
                            {% if content.retrospective is defined %}
                                {{ formRender.addTextfield(content.retrospective,fontNormal) }}
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
            {# project end #}
            {% set projectEnd, tempPrefix = content.projectEnd, tempPrefix~'end.' %}
            <div id="projectEnd">{{ form_label(projectEnd,(tempPrefix~'title')|trans(committeeParams)~':',addLabelAttributes(addClass('MetaData-Label mt-4'))) }}</div>
            <div class="MetaData-Widget fitWidth">
                {{ form_widget(projectEnd) }}
            </div>
            {{ formRender.addHint(tempPrefix~'hint') }}
        </div>
        {# funding #}
        {% set noFunding, fundingPrefix = 'fundingQuali', translationPrefix~'funding.' %}
        {% set selection, anyRequested = getAnySelected(content,fundingKeys,noFunding), false %}
        {% set noSelected, anySelected = selection[0], selection[1] %}
        <div class="mt-8" id="funding">
            <div class="grid" style="grid-template-columns: minmax(min-content,max-content) min-content">{{ formRender.addHeading(fundingPrefix~'title') }}
                <div class="align-self-center" style="margin-left: -1.5rem;">{{ formRender.addPDFhint(transferInfo,'participants') }}</div>
            </div>
            <div class="MetaData-Widget" style="{{ style }}" {{ stimulus_action('base','setMultiCheckbox','change',{'single': noFunding, 'multiCheck': fundingKeys|slice(1)})|stimulus_action(coreDataController,'setReviewProcessWidgets','change') }}>
                {% for widget in fundingKeys %}
                    {% set curWidget, fundingState = content[widget], widget~'FundingState' %}
                    {% set vars = curWidget.vars %}
                    {% set isChecked, name = vars.checked, vars.name %}
                    {% set isFunding, textDiv = name is not same as noFunding, name~'Div' %}
                    <div {% if isFunding %} {{ stimulus_action('base','setVisibility','change',{'multi': [[name,textDiv]]})|stimulus_action(coreDataController,'setConflict','change') }} {% endif %} {% if loop.index>1 %} class="topMarginButtons" {% endif %}>
                        {{ formRender.addCheckbox(curWidget, {'disable': not isFunding and anySelected or isFunding and noSelected, 'target': [coreDataController,name]}) }}
                    </div>
                    {% if isFunding %}
                        <div class="mb-4" id="{{ textDiv }}" style="{{ boolToDisplay(isChecked) }}; margin-top: -1rem">
                            {{ formRender.addTextfield(content[widget~'Text'],fontNormal) }}
                            {% if content[fundingState] is defined %}
                                {% set fundingStateWidget = content[fundingState] %}
                                {% set anyRequested = anyRequested or isChecked and fundingStateWidget.vars.value is same as 'requested' %}
                                <div class="mb-2" id="{{ widget~'fundingStateDiv' }}" style="margin-top: -0.5rem">
                                    {{ formRender.renderButtons(fundingStateWidget,noHeading|merge({'contTarget': [fundingState~'requested',coreDataController,widget~'Requested']})) }}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            {% if textInputRequested is not same as '' %}
                {{ formRender.addHint(textInputRequested,{'target': [coreDataController,'requestedInput'], 'remove': true, 'visible': begun.vars.checked and anyRequested}) }}
            {% endif %}
        </div>
        {# requested confirm #}
        <div class="mt-8" id="requestedConfirmDiv" {{ stimulus_target(coreDataController,'requestedConfirm') }}>
            {{ formRender.addHeading(fundingPrefix~'requestedConfirm.title') }}
            <div class="borderHint" {{ stimulus_target(coreDataController,'requestedConfirmHint') }}></div> {# text is set in controller #}
            <div class="MetaData-Widget">{{ formRender.addCheckbox(content.requestedConfirm) }}</div>
        </div>
        {# qualification #}
        {% if content.qualification is defined %}
            {{ formRender.renderButtons(content.qualification,{'hint': [translationPrefix~'qualification.'], 'stim': [coreDataController,'setApplicant'], 'contTarget': ['qualification0',coreDataController,'qualificationYes'], 'addDiv': ['qualification']}) }}
        {% endif %}
        {# information about the applying person #}
        {% set tempPrefix, infoPrefix = translationPrefix~'applicant.', 'multiple.infos.' %}
        <div class="mt-8" id="applicant">
            {{ formRender.addHeading(tempPrefix~'title',{'headingHint': [[tempPrefix~'headingHint']]}) }}
            <div class="mt-4 fitWidth">
                <div class="MetaData-Widget MetaData-Widget_collection grid gap-x-4" style="grid-template-columns: repeat(2,minmax(min-content,max-content))">
                    {% for info in applicantInfo %}
                        {% set widget, isProfessorship = content[info], info is same as 'professorship' %}
                        {% set vars, isInstitutionPosition, isInstitutionProfessorship = widget.vars, info in ['institution','position'], isProfessorship or info is same as 'institution' %}
                        {% set name, value = vars.name, vars.value %}
                        {% set isOther = value is same as (info~'Other')  %}
                        <div class="justify-content-end">
                            {{ form_label(widget,(info is same as 'phone' ? 'multiple.optional'|trans~' ')~(infoPrefix~info)|trans~':',addLabelAttributes(addClass('align-self-center')|merge({'id': name~'Label', 'style': 'text-align: end'}))|merge({'id': name})) }}
                            {% if info is same as 'department' or isInstitutionProfessorship %}
                                <div {% if isInstitutionProfessorship %} {{ stimulus_target(coreDataController,info~'Hint')}} style="{{ boolToDisplay(isProfessorship ? content['position'].vars.value in ['student','phd'] : isOther) }}" {% endif %}>
                                    {{ formRender.addIcon((infoPrefix~'hints.'~info)|trans(committeeParams)) }}
                                </div>
                            {% endif %}
                        </div>
                        <div {% if isInstitutionPosition %} {{ stimulus_action(coreDataController,'setInstitutionPosition','change') }} {% endif %}>
                            {{ form_widget(widget,{'id': name, 'attr': addStyle('width: 100%'~(isInstitutionPosition ? '; text-overflow: ellipsis'))|merge(isInstitutionPosition ? addClass('Button_dropdown')|merge(info is same as 'position' ? addTarget(coreDataController,'position') : {}) : {})}) }}
                        </div>
                        {% if isInstitutionPosition %}
                            <div id="{{ info~'Other' }}" style="grid-column: 2; {{ boolToDisplay(isOther) }}">{{ form_widget(content[info~'Text']) }}</div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
        {# student confirm #}
        {% if content.studentConfirm is defined %}
            <div id="studentConfirmDiv" class="mt-4" style="{{ boolToDisplay(content.position.vars.value is same as 'student') }}" {{ stimulus_target(coreDataController,'studentConfirm') }}>
                <div class="borderHint">{{ (tempPrefix~'studentConfirm.text')|trans(committeeParams) }}</div>
                <div class="MetaData-Widget">{{ formRender.addCheckbox(content.studentConfirm) }}</div>
            </div>
        {% endif %}
        {# conflict #}
        {% set conflict = content.conflict %}
        <div class="mt-8" id="conflict">
            {{ formRender.renderButtons(conflict,{
                'hint': [conflictPrefix],
                'text': [content.conflictDescription,
                    fontNormal|merge({
                    'attributes': textMinHeightLong,
                    'hint': conflictYesDescription,
                    'textHintID': conflictHint,
                    'resize': true})],
                'stim': [coreDataController,'setConflict'],
                'contTarget': ['conflict1',coreDataController,'conflictNo']}) }} {# correct hint is set in controller, but must not be empty here #}
            {% if textInputConflict is not same as '' %}
                {{ formRender.addHint(textInputConflict,{'target': [coreDataController,'conflictInput'], 'remove': true, 'visible': conflict.vars.value is same as '1'}) }}
            {% endif %}
        </div>
        {# support #}
        {% set tempPrefix = translationPrefix~'support.' %}
        <div class="mt-8" id="support">
            {{ formRender.addHeading(tempPrefix~'title',{'headingHint': [[tempPrefix~'headingHint']]}) }}
            {% set supportKeys, noSupport = support|keys, 'noSupport' %}
            {% set selection = getAnySelected(content,supportKeys,noSupport) %}
            {% set noSelected, anySelected = selection[0], selection[1] %}
            <div class="MetaData-Widget" style="{{ style }}" {{ stimulus_action('base','setMultiCheckbox','change',{'single': 'noSupport', 'multiCheck': supportKeys|slice(1)}) }}>
                {% for widget in supportKeys %}
                    {% set curWidget, isSupport = content[widget], widget is not same as noSupport %}
                    {% set vars = curWidget.vars %}
                    {% set name = vars.name %}
                    <div class="mt-2 {% if loop.index>1 %} topMarginButtons {% endif %}" {% if isSupport %} {{ stimulus_action('base','setVisibility','change',{'multi': [[name,name~'TextDiv']]}) }} {% endif %}>
                        {{ formRender.addCheckbox(curWidget, {'disable': not isSupport and anySelected or isSupport and noSelected}) }}
                    </div>
                    {% if isSupport %}
                        {{ formRender.addTextfield(content[name~'Text'],fontNormal|merge(addStyle('margin-bottom: 1.5rem',true))|merge({'visibility': vars.checked})) }}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        {# guidelines #}
        {% if isEUB %}
            {% set guidelines, description, tempPrefix = content.guidelines, content.guidelinesText, translationPrefix~'guidelines.' %}
            {% set vars = guidelines.vars %}
            {% set name = vars.name %}
            <div class="mt-8" id="guidelinesDiv">
                {{ formRender.addHeading(tempPrefix~'title') }}
                <div class="MetaData-Widget" {{ stimulus_action('base','setVisibility','change',{'multi': [[name,description.vars.name~'Div']]}) }}>
                    {{ form_widget(guidelines,{'id': name, 'attr': checkInput}) }}
                    <label class="CheckBox-Label minAutoGrid" for="{{ name }}"><span>{{ (tempPrefix~'choice')|trans|raw }}</span></label>
                    {{ formRender.addTextfield(description,{'visibility': vars.checked}) }}
                </div>
            </div>
        {% endif %}
    {# modals if review process changes #}
    {% for modal in modals %}
        {{ include('components/redirectModal.html.twig',modal) }}
    {% endfor %}
    </div> {# entire form including stimulus controller #}
    {# buttons #}
    {{ formRender.addSubmitButtons() }}
{% endblock %}

{% block preview %}
    {{ formRender.addPreview() }}
{% endblock %}
